# ===== Secrets / local config（含真实服务器 IP、SSH key 路径、API Key，禁止入库）=====
config.json

# ===== Build artifacts =====
dist/
dist_new/
# 换包时的旧版本备份（mv dist dist_prev_<版本号>），确认新版可用后再删；绝不能入库（381MB）
dist_prev_*/
*.exe
build_*.log

# ===== Windows 保留设备名 =====
# git-bash 下误写 `2>nul` 会生成同名字节文件，且因是保留设备名而无法删除，
# 这里直接忽略，避免污染 git status。
nul
con
aux
prn

# ===== Git 本地备份 / 改史临时目录（绝不能入库）=====
# 改写历史前会 `cp -r .git .git_backup_pre_filter`，
# 若不忽略，一次 `git add -A` 就会把整个 .git（618 个文件）提交进仓库。
.git_backup*/
.git-rewrite/
.gitfilter-branch/

# ===== 一次性临时脚本（用完即弃，绝不入库）=====
# ⚠️ 这些脚本会读真实 config.json 做扫描，检测正则一旦硬编码真值，
#    脚本本身就变成泄露源（2026-10-30 真实踩过：硬编码正则被扫出来）。
tools/_tmp_*

# ===== Node =====
node_modules/

# ===== Python =====
__pycache__/
*.pyc
.venv/
venv/
backend/build/
backend/build_venv/

# ===== Sync output（运行时生成）=====
backend/data/

# ===== OS =====
.DS_Store
Thumbs.db
